<section class="seccion-formulario">
  <h2>Datos del Inmueble</h2>
  <div class="grid-campos">
    <div class="grupo-entrada ancho-completo">
      <label for="campo-inmueble-direccion">Dirección del Inmueble</label>
      <input type="text" id="campo-inmueble-direccion" placeholder="Ej: Ciudad, calle, nº, piso">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,grandes">
      <label for="campo-inmueble-sup-construida">Superficie construida (m²)</label>
      <input type="text" id="campo-inmueble-sup-construida" placeholder="Ej: 90">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,grandes">
      <label for="campo-inmueble-sup-util">Superficie útil (m²)</label>
      <input type="text" id="campo-inmueble-sup-util" placeholder="Ej: 80">
    </div>
    <div class="grupo-entrada">
      <label for="campo-registro-numero">Registro de la Propiedad nº</label>
      <input type="text" id="campo-registro-numero" placeholder="Ej: 3">
    </div>
    <div class="grupo-entrada">
      <label for="campo-registro-finca">Nº de finca registral</label>
      <input type="text" id="campo-registro-finca" placeholder="Ej: 12345">
    </div>
    <div class="grupo-entrada">
      <label for="campo-registro-catastro">Referencia catastral</label>
      <input type="text" id="campo-registro-catastro" placeholder="Ej: 1234567AB7890S">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="grandes">
      <label for="campo-registro-tomo">Tomo</label>
      <input type="text" id="campo-registro-tomo" placeholder="Ej: 1234">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="grandes">
      <label for="campo-registro-libro">Libro</label>
      <input type="text" id="campo-registro-libro" placeholder="Ej: 567">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="grandes">
      <label for="campo-registro-folio">Folio</label>
      <input type="text" id="campo-registro-folio" placeholder="Ej: 89">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="grandes">
      <label for="campo-grandes-registro-ciudad">Registro (ciudad)</label>
      <input type="text" id="campo-grandes-registro-ciudad" placeholder="Ej: Madrid">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,grandes">
      <label for="campo-inmueble-notaria">Notaría (ciudad)</label>
      <input type="text" id="campo-inmueble-notaria" placeholder="Ej: Nombre del notario y ciudad">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,grandes">
      <label for="campo-inmueble-notario-nombre">Nombre del notario</label>
      <input type="text" id="campo-inmueble-notario-nombre" placeholder="Ej: Don/Doña">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,grandes">
      <label for="campo-inmueble-fecha-escritura">Fecha escritura</label>
      <input type="text" id="campo-inmueble-fecha-escritura" placeholder="Ej: 1 de enero de 2020">
    </div>
  </div>
</section>
