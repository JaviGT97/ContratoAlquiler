<section class="seccion-formulario">
  <h2>Datos de Contacto y Notificaciones</h2>
  <div class="grid-campos">
    <div class="grupo-entrada">
      <label for="campo-arrendador-telefono">Teléfono del arrendador</label>
      <input type="text" id="campo-arrendador-telefono" placeholder="Ej: 600 000 000">
    </div>
    <div class="grupo-entrada">
      <label for="campo-arrendador-email">Email del arrendador</label>
      <input type="text" id="campo-arrendador-email" placeholder="Ej: email@ejemplo.com">
    </div>
    <div class="grupo-entrada">
      <label for="campo-arrendatario-telefono">Teléfono del arrendatario</label>
      <input type="text" id="campo-arrendatario-telefono" placeholder="Ej: 600 000 000">
    </div>
    <div class="grupo-entrada">
      <label for="campo-arrendatario-email">Email del arrendatario</label>
      <input type="text" id="campo-arrendatario-email" placeholder="Ej: email@ejemplo.com">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,local">
      <label for="campo-avalista-telefono2">Teléfono del avalista</label>
      <input type="text" id="campo-avalista-telefono2" placeholder="Ej: 600 000 000">
    </div>
    <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda,local">
      <label for="campo-avalista-email2">Email del avalista</label>
      <input type="text" id="campo-avalista-email2" placeholder="Ej: email@ejemplo.com">
    </div>
  </div>
</section>
