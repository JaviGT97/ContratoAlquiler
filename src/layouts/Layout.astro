---
export interface Props {
  title?: string;
}
const { title = 'Editor de Contratos de Alquiler' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="stylesheet" href={import.meta.env.BASE_URL + '/styles/editor.css'}>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📄</text></svg>">
</head>
<body>
  <slot />
  <script src={import.meta.env.BASE_URL + '/scripts/editor.js'} defer></script>
</body>
</html>
