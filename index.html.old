<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Editor de Contratos de Alquiler</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --primary: #1a3a5c; --primary-light: #2a5a8c; --accent: #0ea5e9; --accent-dark: #0284c7;
  --success: #10b981; --success-dark: #059669; --warning: #f59e0b; --bg: #f1f5f9;
  --card: #ffffff; --text: #0f172a; --text-secondary: #475569; --text-muted: #94a3b8;
  --border: #e2e8f0; --border-focus: #0ea5e9; --radius: 12px; --radius-sm: 8px;
  --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-lg: 0 4px 24px rgba(0,0,0,0.1);
  --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
  --font-serif: 'Times New Roman', Georgia, serif;
}
body { font-family: var(--font); background: var(--bg); color: var(--text); min-height: 100vh; padding: 24px; line-height: 1.6; }
.contenedor { max-width: 860px; margin: 0 auto; }
.cabecera { text-align: center; padding: 32px 24px; margin-bottom: 28px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); border-radius: var(--radius); color: white; box-shadow: var(--shadow-lg); }
.cabecera h1 { font-size: 1.65rem; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 6px; }
.cabecera p { font-size: 0.95rem; opacity: 0.85; }
.selector-tipo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
.tipo-card { background: var(--card); border: 2px solid var(--border); border-radius: var(--radius); padding: 16px 20px 16px 44px; cursor: pointer; transition: all 0.25s; text-align: left; position: relative; }
.tipo-card:hover:not(.activo) { border-color: var(--accent); box-shadow: var(--shadow-lg); }
.tipo-card.activo { border-color: var(--accent); background: linear-gradient(135deg, #f0f9ff 0%, #fff 100%); box-shadow: 0 0 0 2px rgba(14,165,233,0.15); }
.tipo-card.activo::before { content: ''; position: absolute; left: 0; top: 4px; bottom: 4px; width: 4px; background: var(--accent); border-radius: 0 4px 4px 0; }
.tipo-card .radio-dot { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--text-muted); transition: all 0.25s; display: flex; align-items: center; justify-content: center; }
.tipo-card.activo .radio-dot { border-color: var(--accent); background: var(--accent); }
.tipo-card.activo .radio-dot::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #fff; }
.tipo-card h3 { font-size: 0.95rem; font-weight: 600; color: var(--primary); margin-bottom: 2px; }
.tipo-card.activo h3 { color: var(--primary); }
.tipo-card p { font-size: 0.78rem; color: var(--text-secondary); }
.tipo-card .tag { display: inline-block; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 8px; border-radius: 4px; margin-top: 4px; }
.tipo-card .tag.disponible { background: #d1fae5; color: #065f46; }
.tipo-card.activo .tag.disponible { background: #d1fae5; color: #065f46; }
.nota-legal { background: #fffbeb; border: 1px solid #fde68a; border-left: 4px solid var(--warning); border-radius: var(--radius-sm); padding: 16px 20px; margin-bottom: 20px; font-size: 0.85rem; color: #78350f; line-height: 1.7; display: none; }
.nota-legal.visible { display: block; }
.nota-legal h4 { font-size: 0.9rem; font-weight: 700; margin-bottom: 8px; color: #92400e; }
.nota-legal strong { color: #78350f; }
.nota-legal ul { margin: 6px 0 6px 20px; }
.nota-legal li { margin-bottom: 3px; }
.seccion-formulario { background: var(--card); border-radius: var(--radius); padding: 20px 24px; margin-bottom: 16px; box-shadow: var(--shadow); border: 1px solid var(--border); transition: box-shadow 0.2s, border-color 0.2s; }
.seccion-formulario:hover { box-shadow: var(--shadow-lg); border-color: var(--accent); }
.seccion-formulario h2 { font-size: 0.95rem; font-weight: 600; color: var(--primary); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: flex; align-items: center; gap: 8px; }
.seccion-formulario h2::before { content: ''; display: inline-block; width: 4px; height: 18px; background: var(--accent); border-radius: 2px; }
.grid-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
.grid-campos .ancho-completo { grid-column: 1 / -1; }
.grupo-entrada { display: flex; flex-direction: column; gap: 4px; }
.grupo-entrada label { font-size: 0.75rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.3px; }
.grupo-entrada input, .grupo-entrada select { padding: 9px 12px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-size: 0.88rem; font-family: var(--font); color: var(--text); background: var(--card); transition: border-color 0.2s, box-shadow 0.2s; outline: none; }
.grupo-entrada input:focus, .grupo-entrada select:focus { border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12); }
.grupo-entrada input::placeholder { color: var(--text-muted); font-size: 0.82rem; }
.grupo-entrada select { cursor: pointer; }
.grupo-tipo { display: none; }
.grupo-tipo.visible { display: block; }
.botones { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
.botones .ancho-completo { grid-column: 1 / -1; }
.boton { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 24px; border: none; border-radius: var(--radius-sm); font-size: 0.92rem; font-weight: 600; font-family: var(--font); cursor: pointer; transition: all 0.2s; text-decoration: none; }
.boton-pdf { background: var(--success); color: white; }
.boton-pdf:hover { background: var(--success-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35); }
.boton-imprimir { background: var(--accent); color: white; }
.boton-imprimir:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(14, 165, 233, 0.35); }
.boton-restablecer { background: transparent; color: var(--text-secondary); border: 1.5px solid var(--border); }
.boton-restablecer:hover { background: var(--bg); border-color: var(--text-muted); color: var(--text); }
.boton svg { width: 18px; height: 18px; flex-shrink: 0; }
.notificacion { display: none; padding: 12px 18px; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 500; margin-bottom: 20px; animation: deslizar 0.3s ease; }
.notificacion.mostrar { display: flex; align-items: center; gap: 8px; }
.notificacion.exito { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
@keyframes deslizar { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
.vista-impresion { display: none; }
@media (max-width: 640px) {
  body { padding: 12px; }
  .cabecera { padding: 24px 16px; } .cabecera h1 { font-size: 1.3rem; }
  .selector-tipo { grid-template-columns: 1fr; }
  .seccion-formulario { padding: 14px; } .grid-campos { grid-template-columns: 1fr; }
  .botones { grid-template-columns: 1fr; }
}
@media print {
  @page { size: A4; margin: 2.5cm 2cm 2.5cm 2cm; }
  body { background: #fff; padding: 0; margin: 0; font-family: var(--font-serif); font-size: 11pt; color: #000; line-height: 1.5; }
  .contenedor { display: none; }
  .vista-impresion { display: block !important; text-align: justify; }
  .texto-centrado { text-align: center; } .texto-negrita { font-weight: bold; }
  p { margin-bottom: 12pt; margin-top: 0; }
  .contenedor-firmas { display: flex; justify-content: space-between; margin-top: 50pt; page-break-inside: avoid; }
  .bloque-firma { width: 45%; text-align: center; }
  .saltopagina { page-break-before: always; }
  .nota-legal-print { font-size: 9pt; color: #333; border: 1px solid #999; padding: 10px 14px; margin-bottom: 16pt; background: #f9f9f9; }
  .nota-legal-print h4 { font-size: 10pt; margin-bottom: 6px; }
}
</style>
</head>
<body>

<div class="contenedor">
  <header class="cabecera">
    <h1>Editor de Contratos de Alquiler</h1>
    <p>Seleccione el tipo de contrato y complete los datos</p>
  </header>

  <div id="notificacion" class="notificacion"></div>

  <!-- SELECTOR DE TIPO -->
  <div class="selector-tipo">
    <div class="tipo-card" data-tipo="temporada" onclick="seleccionarTipo('temporada')">
      <span class="radio-dot"></span>
      <h3>Alquiler de Temporada</h3>
      <p>Para periodos definidos con motivo específico (trabajo, estudios, etc.)</p>
      <span class="tag disponible">Disponible</span>
    </div>
    <div class="tipo-card" data-tipo="vivienda" onclick="seleccionarTipo('vivienda')">
      <span class="radio-dot"></span>
      <h3>Vivienda Habitual</h3>
      <p>Para cubrir la necesidad permanente de vivienda</p>
      <span class="tag disponible">Disponible</span>
    </div>
    <div class="tipo-card" data-tipo="local" onclick="seleccionarTipo('local')" style="opacity:0.5;cursor:not-allowed;">
      <span class="radio-dot"></span>
      <h3>Local Comercial</h3>
      <p>Para locales, naves y espacios comerciales</p>
      <span class="tag" style="background:#fef3c7;color:#92400e;">Próximamente</span>
    </div>
    <div class="tipo-card" data-tipo="grandes" onclick="seleccionarTipo('grandes')" style="opacity:0.5;cursor:not-allowed;">
      <span class="radio-dot"></span>
      <h3>Grandes Tenedores</h3>
      <p>Para propietarios con más de 10 inmuebles</p>
      <span class="tag" style="background:#fef3c7;color:#92400e;">Próximamente</span>
    </div>
  </div>

  <!-- NOTA LEGAL TEMPORADA -->
  <div class="nota-legal visible" id="nota-temporada">
    <h4>Notas sobre el contrato de temporada</h4>
    <p>Los contratos de temporada están dentro del ámbito especial de la norma en materia de arrendamientos urbanos, se equiparan a los denominados <strong>"uso distinto de vivienda"</strong>.</p>
    <p>Lo relevante para concluir si nos encontramos ante un contrato de temporada o un contrato de vivienda habitual <strong>no es el número de meses</strong> que dure el contrato sino <strong>su finalidad</strong>.</p>
    <p>Por ello es necesario que la causa que justifique la temporalidad del contrato se haga constar (estudios, motivos laborales, etcétera).</p>
    <p><strong>Un contrato de temporada con una finalidad correcta provoca:</strong></p>
    <ul>
      <li>Que el contrato termine en la fecha acordada, sin prórrogas (LAU arts. 9 y 10).</li>
      <li>Que queden gobernados 1º por los pactos entre las partes, 2º por la LAU (art. 29 a 35), y subsidiariamente al Código Civil.</li>
      <li>La fianza será de <strong>dos meses</strong> (uso distinto de vivienda).</li>
    </ul>
    <p><strong>Importante:</strong> No confundir con alquiler turístico. Si se realiza en "Fraude de Ley", su tratamiento será el de vivienda habitual.</p>
  </div>

  <!-- NOTA LEGAL VIVIENDA -->
  <div class="nota-legal" id="nota-vivienda">
    <h4>Notas sobre el contrato de vivienda habitual</h4>
    <p>Este contrato se rige por la Ley 29/1994 de Arrendamientos Urbanos (LAU), modificada por el Real Decreto-ley 7/2019 y la Ley 12/2023 por el Derecho a la Vivienda.</p>
    <p><strong>Características principales:</strong></p>
    <ul>
      <li>Duración mínima de <strong>5 años</strong> (7 si el arrendador es persona jurídica), con prórrogas obligatorias.</li>
      <li>El arrendatario puede desistir con 30 días de antelación, indemnizando con una mensualidad por año restante.</li>
      <li>La renta se revisa anualmente según el Índice de Referencia de Arrendamientos de Vivienda (IRAV).</li>
      <li>La fianza legal es de <strong>una mensualidad</strong>.</li>
      <li>El arrendador puede recuperar la vivienda para uso propio tras el primer año (art. 9.3 LAU).</li>
    </ul>
  </div>

  <!-- ARRENDADOR -->
  <section class="seccion-formulario">
    <h2>Datos del Arrendador</h2>
    <div class="grid-campos">
      <div class="grupo-entrada ancho-completo">
        <label>Nombre Completo</label>
        <input type="text" id="campo-arrendador-nombre" placeholder="Ej: JUAN ANTONIO GARRIDO DIAZ">
      </div>
      <div class="grupo-entrada">
        <label>DNI / NIF</label>
        <input type="text" id="campo-arrendador-dni" placeholder="Ej: 12.345.678-Z">
      </div>
      <div class="grupo-entrada">
        <label>Dirección (domicilio)</label>
        <input type="text" id="campo-arrendador-direccion" placeholder="Ej: Ciudad, calle, nº">
      </div>
      <div class="grupo-entrada">
        <label>Estado civil</label>
        <input type="text" id="campo-arrendador-estado" placeholder="Ej: casado/a, soltero/a">
      </div>
      <div class="grupo-entrada">
        <label>Régimen</label>
        <input type="text" id="campo-arrendador-regimen" placeholder="Ej: gananciales, separación">
      </div>
    </div>
  </section>

  <!-- ARRENDATARIO -->
  <section class="seccion-formulario">
    <h2>Datos del Arrendatario</h2>
    <div class="grid-campos">
      <div class="grupo-entrada ancho-completo">
        <label>Nombre Completo</label>
        <input type="text" id="campo-arrendatario-nombre" placeholder="Ej: MARIA JIMENEZ ARCO">
      </div>
      <div class="grupo-entrada">
        <label>DNI / NIF</label>
        <input type="text" id="campo-arrendatario-dni" placeholder="Ej: 12.345.678-Z">
      </div>
      <div class="grupo-entrada">
        <label>Dirección (domicilio)</label>
        <input type="text" id="campo-arrendatario-direccion" placeholder="Ej: Ciudad, calle, nº">
      </div>
      <div class="grupo-entrada">
        <label>Estado civil</label>
        <input type="text" id="campo-arrendatario-estado" placeholder="Ej: casado/a, soltero/a">
      </div>
      <div class="grupo-entrada">
        <label>Régimen</label>
        <input type="text" id="campo-arrendatario-regimen" placeholder="Ej: gananciales, separación">
      </div>
      <div class="grupo-entrada ancho-completo grupo-tipo visible" data-mostrar="temporada">
        <label>Domicilio habitual</label>
        <input type="text" id="campo-arrendatario-domicilio" placeholder="Ej: Ciudad, calle, nº (donde reside habitualmente)">
      </div>
    </div>
  </section>

  <!-- AVALISTA -->
  <section class="seccion-formulario grupo-tipo" data-mostrar="vivienda">
    <h2>Datos del Avalista</h2>
    <div class="grid-campos">
      <div class="grupo-entrada ancho-completo">
        <label>Nombre Completo</label>
        <input type="text" id="campo-avalista-nombre" placeholder="Ej: Nombre del avalista">
      </div>
      <div class="grupo-entrada">
        <label>DNI / NIF</label>
        <input type="text" id="campo-avalista-dni" placeholder="Ej: 12.345.678-Z">
      </div>
      <div class="grupo-entrada">
        <label>Dirección</label>
        <input type="text" id="campo-avalista-direccion" placeholder="Ej: Ciudad, calle, nº">
      </div>
      <div class="grupo-entrada">
        <label>Estado civil</label>
        <input type="text" id="campo-avalista-estado" placeholder="Ej: casado/a, soltero/a">
      </div>
      <div class="grupo-entrada">
        <label>Régimen</label>
        <input type="text" id="campo-avalista-regimen" placeholder="Ej: gananciales, separación">
      </div>
      <div class="grupo-entrada">
        <label>Teléfono</label>
        <input type="text" id="campo-avalista-telefono" placeholder="Ej: 600 000 000">
      </div>
      <div class="grupo-entrada">
        <label>Email</label>
        <input type="text" id="campo-avalista-email" placeholder="Ej: email@ejemplo.com">
      </div>
    </div>
  </section>

  <!-- INMUEBLE -->
  <section class="seccion-formulario">
    <h2>Datos del Inmueble</h2>
    <div class="grid-campos">
      <div class="grupo-entrada ancho-completo">
        <label>Dirección del Inmueble</label>
        <input type="text" id="campo-inmueble-direccion" placeholder="Ej: Ciudad, calle, nº, piso">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Superficie construida (m²)</label>
        <input type="text" id="campo-inmueble-sup-construida" placeholder="Ej: 90">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Superficie útil (m²)</label>
        <input type="text" id="campo-inmueble-sup-util" placeholder="Ej: 80">
      </div>
      <div class="grupo-entrada">
        <label>Registro de la Propiedad nº</label>
        <input type="text" id="campo-registro-numero" placeholder="Ej: 3">
      </div>
      <div class="grupo-entrada">
        <label>Nº de finca registral</label>
        <input type="text" id="campo-registro-finca" placeholder="Ej: 12345">
      </div>
      <div class="grupo-entrada">
        <label>Referencia catastral</label>
        <input type="text" id="campo-registro-catastro" placeholder="Ej: 1234567AB7890S">
      </div>

      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Notaría (ciudad)</label>
        <input type="text" id="campo-inmueble-notaria" placeholder="Ej: Nombre del notario y ciudad">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Nombre del notario</label>
        <input type="text" id="campo-inmueble-notario-nombre" placeholder="Ej: Don/Doña">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Fecha escritura</label>
        <input type="text" id="campo-inmueble-fecha-escritura" placeholder="Ej: 1 de enero de 2020">
      </div>
    </div>
  </section>

  <!-- CONTRATO -->
  <section class="seccion-formulario">
    <h2>Datos del Contrato</h2>
    <div class="grid-campos">
      <div class="grupo-entrada ancho-completo">
        <label>Lugar y Fecha de Firma</label>
        <input type="text" id="campo-contrato-lugar-fecha" placeholder="Ej: En Madrid, a 1 de enero de 2025">
      </div>

      <!-- Campos TEMPORADA -->
      <div class="grupo-entrada ancho-completo grupo-tipo visible" data-mostrar="temporada">
        <label>Motivo de la temporalidad</label>
        <input type="text" id="campo-contrato-motivo" placeholder="Ej: trabajo, estudio, tratamiento médico...">
      </div>
      <div class="grupo-entrada grupo-tipo visible" data-mostrar="temporada">
        <label>Fecha de Inicio</label>
        <input type="text" id="campo-contrato-inicio" placeholder="Ej: 1 de enero de 2025">
      </div>
      <div class="grupo-entrada grupo-tipo visible" data-mostrar="temporada">
        <label>Fecha de Fin</label>
        <input type="text" id="campo-contrato-fin" placeholder="Ej: 31 de enero de 2025">
      </div>
      <div class="grupo-entrada grupo-tipo visible" data-mostrar="temporada">
        <label>Precio total (en letra)</label>
        <input type="text" id="campo-renta-letra" placeholder="Ej: TRES MIL EUROS">
      </div>
      <div class="grupo-entrada grupo-tipo visible" data-mostrar="temporada">
        <label>Precio total (número)</label>
        <input type="text" id="campo-renta-numero" placeholder="Ej: 3.000,00">
      </div>
      <div class="grupo-entrada ancho-completo grupo-tipo visible" data-mostrar="temporada">
        <label>Forma de pago</label>
        <select id="campo-contrato-forma-pago">
          <option value="unico">Pago único antes del inicio</option>
          <option value="mensual">Mensualidades anticipadas</option>
        </select>
      </div>
      <div class="grupo-entrada ancho-completo grupo-tipo visible" data-mostrar="temporada">
        <label>IBAN para domiciliación</label>
        <input type="text" id="campo-contrato-iban" placeholder="Ej: ES00 0000 0000 0000 0000 0000">
      </div>
      <div class="grupo-entrada grupo-tipo visible" data-mostrar="temporada">
        <label>Importe de la fianza</label>
        <input type="text" id="campo-contrato-fianza" placeholder="Ej: 600,00">
      </div>
      <div class="grupo-entrada grupo-tipo visible" data-mostrar="temporada">
        <label>Opción suministros</label>
        <select id="campo-contrato-suministros">
          <option value="opcion1">Opción 1: Pago junto con la renta</option>
          <option value="opcion2">Opción 2: Domiciliación bancaria</option>
          <option value="opcion3">Opción 3: Cambio de titularidad</option>
        </select>
      </div>
      <div class="grupo-entrada ancho-completo grupo-tipo visible" data-mostrar="temporada">
        <label>Nombre de los convivientes</label>
        <input type="text" id="campo-contrato-convivientes" placeholder="Ej: nombre de las personas con las que convive">
      </div>

      <!-- Campos VIVIENDA -->
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Fecha de inicio del contrato</label>
        <input type="text" id="campo-vivienda-inicio" placeholder="Ej: 1 de enero de 2025">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Duración (años)</label>
        <input type="text" id="campo-vivienda-duracion" placeholder="Ej: 1">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
        <label>Renta mensual (en letra)</label>
        <input type="text" id="campo-vivienda-renta-letra" placeholder="Ej: QUINIENTOS EUROS">
      </div>
      <div class="grupo-entrada grupo-tipo" data-mostrar="vivienda">
